# Copy to backend/.env (gitignored) and fill in the values locally.
# Never commit real values.

# PostgreSQL connection string (psycopg 3 driver).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Base URL of the authentication provider.
SUPABASE_URL=

# Who may use the API: comma-separated user IDs (the `sub` of the token) and/or emails. Set at
# least one; if both are empty, every protected route refuses to answer.
ALLOWED_USER_IDS=
ALLOWED_USER_EMAILS=

# Comma-separated origins allowed by CORS (the PWA and local dev).
ALLOWED_ORIGINS=http://localhost:5173

# Key that encrypts stored third-party credentials (Fernet: urlsafe base64 of 32 bytes).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Refresh exchange rates and balances when the process starts, if they are stale (true/false).
REFRESH_ON_STARTUP=false

# Serve the interactive API docs at /docs (true/false). Turn off on a public deployment.
DOCS_ENABLED=true

# Base URL (ending in /api/v1) of another deployment of this API that reads the exchange for this one.
# Needed only when this one runs in a country the exchange refuses. Leave empty to read it directly.
BINANCE_SYNC_URL=

# Reading the mailbox (read-only). Create an OAuth client of type "Web application" with the Gmail API enabled, and
# register GOOGLE_REDIRECT_URI as one of its authorized redirect addresses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This API's callback, for example http://localhost:8000/api/v1/integrations/gmail/callback
GOOGLE_REDIRECT_URI=
# Where the app is served; the person returns here after allowing access.
APP_URL=http://localhost:5173/
# Comma-separated addresses the bank's notifications come from (a default is built in).
GMAIL_SENDERS=
# Days before today the first read of the mailbox goes back; 0 (the default) reads from the start of today.
GMAIL_FIRST_SYNC_DAYS=0
