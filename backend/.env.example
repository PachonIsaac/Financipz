# Copy to backend/.env (gitignored) and fill in the values locally.
# Never commit real values.

# PostgreSQL connection string (psycopg 3 driver).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Base URL of the authentication provider.
SUPABASE_URL=

# Comma-separated user IDs allowed to use the API (the `sub` of the token). Empty accepts any
# user of the authentication provider.
ALLOWED_USER_IDS=

# Comma-separated origins allowed by CORS (the PWA and local dev).
ALLOWED_ORIGINS=http://localhost:5173
